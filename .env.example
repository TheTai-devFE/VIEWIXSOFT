# Viewixsoft Enterprise Environment Variables Example

# ==========================================
# Database (PostgreSQL - Neon / Supabase)
# ==========================================
DATABASE_URL="postgresql://viewix_user:your_password@ep-cool-lake-123456.us-east-2.aws.neon.tech/viewix_db?sslmode=require"

# ==========================================
# Email Notifications (Resend)
# ==========================================
# In local development without this key, email notifications will be logged to the console
RESEND_API_KEY="re_1234567890abcdef"
SALES_NOTIFICATION_EMAIL="sales@viewixsoft.com"

# ==========================================
# Anti-Spam (Cloudflare Turnstile)
# ==========================================
# In local development without this key, mock verification passes automatically
TURNSTILE_SITE_KEY="0x4AAAAAAAx..."
TURNSTILE_SECRET_KEY="0x4AAAAAAAx..."

# ==========================================
# Admin Portal Authentication (Better Auth)
# ==========================================
BETTER_AUTH_SECRET="super-secret-random-32-character-token"
BETTER_AUTH_URL="http://localhost:3000"

# Initial Admin Bootstrap Account
ADMIN_EMAIL="admin@viewixsoft.com"
ADMIN_PASSWORD="SecureEnterprisePassword2026!"
