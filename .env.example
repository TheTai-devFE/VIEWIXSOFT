# Copy to .env for `pnpm dev` (and to .dev.vars for `pnpm cf:preview`).
# Never commit .env or .dev.vars. In production, set secrets with
# `wrangler secret put NAME`; plain settings live in wrangler.jsonc "vars".
# Every group is optional in development: a missing value turns the feature off
# (no Turnstile check, emails logged instead of sent, uploads saved to .data/).
# In production, forms and admin sign-in refuse to run without their secrets.

# ── Site ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
SITE_URL=http://localhost:3000

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Use the pooled connection string. Create a separate Neon branch for dev.
DATABASE_URL=

# ── Admin sign-in (Better Auth) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Privacy ──────────────────────────────────────────────────────────────────
# Salt for hashing visitor IPs (only the hash is stored). openssl rand -base64 32
IP_HASH_SALT=

# ── Anti-spam (Cloudflare Turnstile) ─────────────────────────────────────────
# The site key is public and inlined at build time; set it in the build environment.
VITE_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Viewixsoft <hello@viewixsoft.com>"
SALES_NOTIFICATION_EMAIL=sales@viewix.hk

# ── Images (Cloudflare R2, S3 API token with Object Read & Write) ────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=viewixsoft-media
# Public URL of the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_URL=
# "true" once Image Transformations are enabled on the Cloudflare zone.
VITE_PUBLIC_IMAGE_TRANSFORMS=

# ── One-off: pnpm admin:create reads these (or prompts for the password) ─────
ADMIN_EMAIL=
