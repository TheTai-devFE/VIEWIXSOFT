    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "@tanstack/react-table": "^8.21.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.7"
  },
